# =========================================================================
# Production env for co-hosting Xorder on the Operix VPS (behind Operix nginx).
# Copy to .env.production and fill APP_KEY + DB_PASSWORD + OPERIX_PROXY_NETWORK.
# TLS terminates at Operix's outer nginx; this app trusts the forwarded scheme.
# =========================================================================

APP_NAME="Xorder"
APP_ENV=production
# Generate on the VPS:  docker compose ... run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://xorder.io

# Signing secret for stateless API access tokens (HS256). REQUIRED — an empty
# value makes every login return 500. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# Logs to stdout/stderr so `docker compose logs` shows them.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (PostgreSQL service in docker-compose.cohost.yml) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xorder
DB_USERNAME=xorder
# Generate a strong value (e.g. openssl rand -hex 24) and keep it here only.
DB_PASSWORD=

# --- Sessions / cache / queue (DB-backed, no extra services) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Sanctum SPA cookie auth across xorder.io + every *.xorder.io subdomain ---
SANCTUM_STATEFUL_DOMAINS=xorder.io,*.xorder.io
# Host-only session cookie (no Domain attribute): each subdomain gets its own
# session. Sanctum's wildcard stateful list still authenticates each one.
SESSION_DOMAIN=null
# HTTPS is terminated upstream; force the secure cookie flag explicitly.
SESSION_SECURE_COOKIE=true

# --- Mail (provisioning emails the generated admin password) ---
# SECURITY: do NOT use MAIL_MAILER=log in production. Provisioning/reset emails
# contain the generated admin password in cleartext; the `log` mailer writes
# that whole email — password included — to the application log on disk. Always
# configure a real SMTP transport before provisioning any tenant.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@xorder.io
MAIL_FROM_NAME="Xorder"

# --- Uploads ---
FILESYSTEM_DISK=public
UPLOAD_DISK=public

# --- Platform: Super Admin bootstrap (used ONCE by go-live.sh seeding) ---
# Generate a strong password (e.g. openssl rand -base64 18) — go-live.sh seeds
# the account from these values. Leaving a guessable default here is an open
# door to the whole platform.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@xorder.io
SUPER_ADMIN_PASSWORD=

# --- Subscription gating ---
HIDE_MENU_WHEN_EXPIRED=false
ENFORCE_SUBSCRIPTION_WRITES=true

# --- Entrypoint behavior ---
# Leave RUN_MIGRATIONS=true (idempotent). Keep SEED_ON_START=false: seeding is
# a one-time go-live.sh step. If left true, every container boot re-runs
# db:seed and RESETS the Super Admin password back to the value above.
RUN_MIGRATIONS=true
SEED_ON_START=false

# --- Public menu subdomain (production) ---
MENU_DOMAIN=xorder.io
MENU_SECURE=true
# Standard 443 -> leave MENU_PORT unset (no value).
MENU_PORT=

# --- Backups (read by deploy.sh, not Laravel) ---
# Local pre-deploy backups live on the SAME disk as Postgres. Set an
# s3-compatible target to also push each backup offsite (needs the aws CLI):
# BACKUP_S3_URI=s3://xorder-backups

# =========================================================================
# Compose-only variable (read by docker-compose.cohost.yml, not Laravel).
# The Docker network Operix's nginx is attached to. Find it on the VPS with:
#   docker network ls
#   docker inspect <operix-nginx-container> --format '{{json .NetworkSettings.Networks}}'
# =========================================================================
OPERIX_PROXY_NETWORK=
