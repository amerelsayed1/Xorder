APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- QR Menu platform ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@qrmenu.test
SUPER_ADMIN_PASSWORD=change-me
# EXPIRED subscription handling: false = menu public + dashboard read-only; true = hide menu
HIDE_MENU_WHEN_EXPIRED=false
ENFORCE_SUBSCRIPTION_WRITES=true
UPLOAD_DISK=public
# Comma-separated hosts allowed to use SPA cookie auth (Sanctum).
# Include the decoupled SPA + landing origins (dev: Vite ports 5173/5174).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,localhost:8123,127.0.0.1,127.0.0.1:8123,::1
# Comma-separated frontend origins allowed to make credentialed (cookie) API calls.
# Prod example: https://app.tryorder.net,https://xorder.net
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Per-restaurant subdomain menus: http://{slug}.localhost:8123/menu (local) or https://{slug}.xorder.net/menu (prod)
# *.localhost resolves to loopback in browsers automatically. Leave MENU_DOMAIN unset for path-based /r/{slug}.
MENU_DOMAIN=localhost
MENU_SECURE=false
MENU_PORT=8123
