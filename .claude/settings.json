{
  "permissions": {
    "deny": [
      "Read(./db-backups/**)",
      "Edit(./db-backups/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(*db-backups*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:refresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(*migrate --force*)",
      "Bash(pg_restore:*)",
      "Bash(dropdb:*)",
      "Bash(*deploy.sh*)",
      "Bash(*go-live.sh*)"
    ]
  }
}
