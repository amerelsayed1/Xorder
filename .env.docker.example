# =========================================================================
# Docker Compose environment template. Copy to .env.docker and fill in:
#   cp .env.docker.example .env.docker
#   docker compose run --rm app php artisan key:generate --show   # -> APP_KEY
# Then set real passwords before any non-local deployment.
# =========================================================================

APP_NAME="QR Menu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# Logs to stdout/stderr so `docker compose logs` shows them.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (PostgreSQL service) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=qrmenu
DB_USERNAME=qrmenu
DB_PASSWORD=CHANGE_ME

# --- Sessions / cache / queue (DB-backed, no extra services) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Sanctum SPA cookie auth — must include the browser-facing host:port.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# --- Mail (provisioning emails the generated admin password) ---
MAIL_MAILER=log

# --- Uploads ---
FILESYSTEM_DISK=public
UPLOAD_DISK=public

# --- Platform: Super Admin bootstrap (CHANGE THESE) ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@qrmenu.test
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Subscription gating ---
HIDE_MENU_WHEN_EXPIRED=false
ENFORCE_SUBSCRIPTION_WRITES=true

# --- Entrypoint behavior ---
RUN_MIGRATIONS=true
SEED_ON_START=true

# Public menu subdomain: http://{slug}.localhost:8080/menu (local) or set xorder.net for prod
MENU_DOMAIN=localhost
MENU_SECURE=false
MENU_PORT=8080
