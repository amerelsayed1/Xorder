# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# The workspace members build and cover inside their own folders.
/packages/*/build/
/apps/*/build/
# Where `flutter test` mirrored font files while an app declared them by a
# `../` path (stage 3). The apps declare no fonts now; kept so a stray copy
# can never be committed.
/apps/*/packages/
/packages/*/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/packages/*/android/app/debug
/packages/*/android/app/profile
/packages/*/android/app/release

# Widget Preview related
.widget_preview/

# Packaged installers produced by scripts/package_macos.sh
/dist/

# Test licences and anything else signed locally. The private key never
# belongs in the repository either — see bin/pos_licence.dart.
/licences/
*.xlic
